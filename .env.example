# Oracle Database
# Oracle connection settings for the feeder's customer and banking records.
ORACLE_USER="replace_with_oracle_user"
ORACLE_PASSWORD=replace_with_oracle_password
ORACLE_CONNECT_STRING=example.invalid:1521/ORCLPDB1
ORACLE_SCHEMA="replace_with_oracle_schema"

# DB2i / AS400
# IBM i source connection settings; configure a DSN or host-based connection.
DB2I_DSN=example_as400_dsn
DB2I_HOST=example.invalid
DB2I_DRIVER="IBM i Access ODBC Driver"
DB2I_JT400_JAR=./db2i_driver/jt400-21.0.6.jar
DB2I_JDBC_URL="jdbc:as400://example.invalid"
DB2I_USER=replace_with_db2i_user
DB2I_PASSWORD=replace_with_db2i_password
DB2I_SCHEMA=replace_with_db2i_schema

# Other configuration
# Demo workload controls and feeder runtime behavior.
DEMO_CUSTOMER_ID=100002
DEMO_ACCOUNT_ID=AC1000021
DEMO_WITHDRAWAL_AMOUNT=200
DEMO_CURRENCY=GBP

# Optional read-only comparison against published TapData APIs.
TAPDATA_API_BASE_URL=https://tapdata.example.invalid
TAPDATA_FIND_PATH_TEMPLATE=/api/v1/{collection}
TAPDATA_COLLECTION_MAP={"CUSTOMER":"MDM_CUSTOMER360"}
TAPDATA_KYC_COLLECTION=CUSTOMER_KYC
TAPDATA_TOKEN_URL=https://auth.example.invalid/oauth/token
TAPDATA_CLIENT_ID=replace_with_tapdata_client_id
TAPDATA_CLIENT_SECRET=replace_with_tapdata_client_secret
TAPDATA_TOKEN_AUTH_METHOD=client_secret_post
TAPDATA_ACCESS_TOKEN=
TAPDATA_FIND_METHOD=GET
TAPDATA_FIND_REQUEST_STYLE=query
TAPDATA_FIND_FILTER={}
TAPDATA_PAGE_SIZE=200
TAPDATA_SCAN_LIMIT=1000
TAPDATA_REQUEST_TIMEOUT_MS=15000
DEMO_API_CDC_RETRY_INTERVAL_MS=2000
DEMO_API_CDC_TIMEOUT_MS=30000


CUSTOMER_COUNT=100
ACCOUNTS_PER_CUSTOMER=2
INITIAL_TRANSACTIONS=5
INTERACTIONS_PER_CUSTOMER=2
LOANS_EVERY_N_CUSTOMERS=5
OFFERS_PER_CUSTOMER=1
BATCH_SIZE=100
REALTIME_INTERVAL_MS=2000
RETRY_LIMIT=5
LOG_LEVEL=info
ALLOW_OVERDRAFT=false
