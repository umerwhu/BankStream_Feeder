# Copy to .env. Keep passwords and tokens private.
# Remote Mode (recommended): set the mode, service URL, and partner token.
# Use local for your own databases and TapData environment.
FEEDER_MODE=remote
# Remote Mode: enter the service URL from your operator.
DEMO_API_URL=https://demo.example.com:8443
# Remote Mode: enter your partner token.
DEMO_API_TOKEN=replace_with_partner_token
# Optional remote request timeout in milliseconds.
DEMO_API_TIMEOUT_MS=150000

# Optional: Local Mode
# Set FEEDER_MODE=local, then update the settings below.
# Remote Mode does not need these settings.

# Oracle Database
# Update the Oracle user, password, host/service, and schema.
ORACLE_USER="replace_with_oracle_user"
ORACLE_PASSWORD=replace_with_oracle_password
ORACLE_CONNECT_STRING=example.invalid:1521/ORCLPDB1
ORACLE_SCHEMA="replace_with_oracle_schema"

# DB2i / AS400
# Set the IBM i host or use an ODBC DSN.
# DB2I_DSN=example_as400_dsn
DB2I_HOST=127.0.0.1

# Keep these defaults unless your setup differs.
DB2I_DRIVER="IBM i Access ODBC Driver"
DB2I_JT400_JAR=./db2i_driver/jt400-21.0.6.jar

# Update the JDBC host/library, user, password, and schema.
DB2I_JDBC_URL="jdbc:as400://127.0.0.1;libraries=BANKCORE;"
DB2I_USER=replace_with_db2i_user
DB2I_PASSWORD=replace_with_db2i_password
DB2I_SCHEMA=replace_with_db2i_schema

# Keep these IDs when using the supplied sample data.

DEMO_CUSTOMER_ID=100002
DEMO_ACCOUNT_ID=AC1000021


# Local Mode: API settings for demo:verify.
# Enter the base URL of your published TapData APIs.
TAPDATA_API_BASE_URL=http://127.0.0.1:3080

# Keep these defaults unless your setup differs.
TAPDATA_FIND_PATH_TEMPLATE=/api/v1/{collection}
TAPDATA_COLLECTION_MAP={"CUSTOMER":"MDM_CUSTOMER360"}
TAPDATA_KYC_COLLECTION=CUSTOMER_KYC


# Enter your OAuth token URL, client ID, and client secret.
TAPDATA_TOKEN_URL=http://127.0.1:3030/oauth/token
TAPDATA_CLIENT_ID=replace_with_tapdata_client_id
TAPDATA_CLIENT_SECRET=replace_with_tapdata_client_secret


# Keep these defaults unless your setup differs.
TAPDATA_TOKEN_AUTH_METHOD=client_secret_post
TAPDATA_ACCESS_TOKEN=
TAPDATA_FIND_METHOD=GET
TAPDATA_FIND_REQUEST_STYLE=query
TAPDATA_FIND_FILTER={}
TAPDATA_PAGE_SIZE=200
TAPDATA_SCAN_LIMIT=1000
TAPDATA_REQUEST_TIMEOUT_MS=15000
DEMO_API_CDC_RETRY_INTERVAL_MS=2000
DEMO_API_CDC_TIMEOUT_MS=30000

# Keep these defaults unless your setup differs.

CUSTOMER_COUNT=100
ACCOUNTS_PER_CUSTOMER=2
INITIAL_TRANSACTIONS=5
INTERACTIONS_PER_CUSTOMER=2
LOANS_EVERY_N_CUSTOMERS=5
OFFERS_PER_CUSTOMER=1
BATCH_SIZE=100
REALTIME_INTERVAL_MS=2000
RETRY_LIMIT=5
LOG_LEVEL=info
ALLOW_OVERDRAFT=false
