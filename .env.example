# Oracle Database
# Oracle connection settings for the feeder's customer and banking records.
ORACLE_USER=C##BANKCRM
ORACLE_PASSWORD=change_me
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_SCHEMA=C##BANKCRM

# DB2i / AS400
# IBM i source connection settings; use an existing DSN or host-based connection.
DB2I_DSN=
DB2I_HOST=192.0.2.10
DB2I_DRIVER=IBM i Access ODBC Driver
DB2I_JT400_JAR=./db2i_driver/jt400-21.0.6.jar
DB2I_JDBC_URL=
DB2I_USER=DB2IDEMO
DB2I_PASSWORD=change_me
DB2I_SCHEMA=BANKCORE
JAVA_COMMAND=java

# Runtime behavior
# Controls retry, logging, and whether demo transactions may overdraw accounts.
RETRY_LIMIT=5
LOG_LEVEL=info
ALLOW_OVERDRAFT=false
